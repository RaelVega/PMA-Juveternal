{
  "name": "pma-juveternal",
  "private": true,
  "version": "0.1.0",
  "description": "Pantalla táctil dual Plantas Medicinales Anáhuac × Juveternal — Expo FAC 2026",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "electron:compilar": "node cascaras/electron/compilar.mjs",
    "electron:dev": "npm run build && npm run electron:compilar && DIR_CONTENIDO=dist/contenido electron .",
    "empaquetar:win": "npm run build && npm run electron:compilar && electron-builder -c cascaras/electron/electron-builder.yml --win",
    "empaquetar:mac": "npm run build && npm run electron:compilar && electron-builder -c cascaras/electron/electron-builder.yml --mac --universal",
    "empaquetar:zips": "node cascaras/electron/empaquetar-zips.mjs",
    "empaquetar:zips:mac": "node cascaras/electron/empaquetar-mac.mjs",
    "armar:usb": "npm run empaquetar:win && node cascaras/usb/armar-usb.mjs",
    "humo:navegador": "node pruebas/humo/navegador.mjs",
    "ingesta": "node ingesta/ingerir.mjs",
    "icono": "node ingesta/icono.mjs",
    "visual": "node pruebas/visual/recorrido.mjs",
    "motor:comparar": "node scripts/motor.mjs comparar",
    "motor:traer": "node scripts/motor.mjs traer"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dexie": "^4.4.6",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "motion": "^13.4.1",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "author": "Xestión Intelixente"
}
